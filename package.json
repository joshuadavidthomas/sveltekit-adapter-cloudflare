{
	"name": "@joshthomas/sveltekit-adapter-cloudflare",
	"version": "0.3.0",
	"description": "Fork of @sveltejs/adapter-cloudflare with support for scheduled, queue, and email handlers",
	"keywords": [
		"adapter",
		"cloudflare pages",
		"cloudflare workers",
		"deploy",
		"hosting",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joshuadavidthomas/sveltekit-adapter-cloudflare.git"
	},
	"bugs": {
		"url": "https://github.com/joshuadavidthomas/sveltekit-adapter-cloudflare/issues"
	},
	"license": "MIT",
	"homepage": "https://github.com/joshuadavidthomas/sveltekit-adapter-cloudflare#readme",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"files/worker.js",
		"src/virtual-cloudflare-workers.js",
		"index.js",
		"utils.js",
		"index.d.ts"
	],
	"scripts": {
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"check": "tsc && tsc --project files/tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test",
		"test": "pnpm test:unit && pnpm test:e2e"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^5.20260925.1",
		"@rolldown/pluginutils": "^1.0.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/kit": "^3.1.0",
		"@types/node": "^26.6.5",
		"oxfmt": "^0.73.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0",
		"wrangler": "^4.118.0"
	},
	"packageManager": "pnpm@12.0.0"
}
