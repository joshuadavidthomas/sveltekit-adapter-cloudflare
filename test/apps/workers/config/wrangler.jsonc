// we've moved the wrangler config away from the root of the project
// to test that the adapter still resolves the paths correctly
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"main": "../dist/index.js",
	"compatibility_date": "2026-06-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "../dist/public",
		"binding": "ASSETS"
	},
	"vars": {
		"FOO": "from wrangler.jsonc"
	},
	"durable_objects": {
		"bindings": [{ "name": "EXAMPLE_DO", "class_name": "ExampleDurableObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExampleDurableObject"] }]
}
