{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		// playwright and worker types are a mess
		"skipLibCheck": true,
		// taken from the Cloudflare Workers TypeScript template https://github.com/cloudflare/workers-sdk/blob/main/packages/create-cloudflare/templates/hello-world/ts/tsconfig.json
		"target": "es2024",
		"lib": ["es2024"],
		"types": ["node"]
	},
	"include": [
		"index.js",
		"index.spec.js",
		"vitest.config.js",
		"src",
		"utils.js",
		"utils.spec.js",
		"globals.d.ts",
		"test/utils.js"
	]
}
